msgstr "Профессиональная команда"

msgctxt "why1d"
msgid "100-dən çox mütəxəssis, 4 regional ofis, ciddi iş qrafiki və keyfiyyət nəzarəti."
msgstr "Более 100 специалистов, 4 региональных офиса, строгий график и контроль качества."

msgctxt "why2"
msgid "Operativ icra"
msgstr "Оперативное исполнение"

msgctxt "why2d"
msgid "Razılaşdırılmış müddətlərə riayət. İş qrafiki müştəri ilə şəffaf paylaşılır."
msgstr "Соблюдение согласованных сроков. Прозрачный график работ для клиента."

msgctxt "why3"
msgid "Keyfiyyətə nəzarət"
msgstr "Контроль качества"

msgctxt "why3d"
